# MongoDB Configuration
# Enable authentication on the database and use credentials in production:
#   MONGO_STRING=mongodb://user:pass@host:27017/?authSource=admin
MONGO_STRING=mongodb://mongodb:27017

# Server Configuration
PORT=8080
LISTENING_IP=0.0.0.0
# REQUIRED in production: at least 32 random characters. The process refuses to
# start without one when NODE_ENV=production.
# Generate with: openssl rand -hex 32
SESSION_SECRET=
# Public origin of the site. Use https:// in production: it turns on HSTS and the
# Secure flag on the session cookie.
ORIGIN=http://localhost:8080
# Set to 1 (or a hop count) ONLY when running behind a reverse proxy you control,
# so client IPs are read from X-Forwarded-For. Leave empty otherwise: a spoofed
# header would defeat the login rate limits.
TRUST_PROXY=

# OAuth Configuration (optional)
FACEBOOK_ENABLED=false
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

TWITTER_ENABLED=false
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=

GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
